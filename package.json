{
  "name": "aicaffe",
  "version": "1.0.0",
  "description": "AiCaffe Marketplace-as-an-OS - Unified AI Gateway",
  "main": "dist/index.js",
  "scripts": {
    "cleanup": "node scripts/cleanup.js",
    "dev": "node scripts/cleanup.js && node scripts/dev.js",
    "seed": "cd services && venv\\Scripts\\python ../database/seed.py",
    "frontend": "npm run dev --prefix frontend",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
