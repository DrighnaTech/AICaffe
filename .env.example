# ═══════════════════════════════════════════════════════════════════════════════
# AICaffe Production Environment Configuration
# Copy this to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aicaffe

# For Docker/Production:
# DB_HOST=postgres
# DB_USER=aicaffe
# DB_PASSWORD=your_secure_password_here

# ── JWT Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=your-super-secure-jwt-secret-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── Stripe Payment Integration ──────────────────────────────────────────────────
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create these in Stripe Dashboard under Products)
STRIPE_EXPLORER_MONTHLY_PRICE_ID=price_explorer_monthly
STRIPE_EXPLORER_YEARLY_PRICE_ID=price_explorer_yearly
STRIPE_BUILDER_MONTHLY_PRICE_ID=price_builder_monthly
STRIPE_BUILDER_YEARLY_PRICE_ID=price_builder_yearly

# ── Frontend URL ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# For production:
# FRONTEND_URL=https://aicaffe.com

# ── API Gateway (for frontend) ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
# For production:
# NEXT_PUBLIC_API_URL=https://api.aicaffe.com

# ── Service URLs (for API Gateway - use Docker service names in production) ─────
AUTH_SERVICE_URL=http://localhost:8001
MODEL_REGISTRY_URL=http://localhost:8002
TOKEN_SERVICE_URL=http://localhost:8003
RECOMMENDATION_URL=http://localhost:8004
NEWS_SERVICE_URL=http://localhost:8005
AI_PROXY_URL=http://localhost:8006
BILLING_SERVICE_URL=http://localhost:8007
STORAGE_SERVICE_URL=http://localhost:8008
WORKSPACE_SERVICE_URL=http://localhost:8009
ORCHESTRATOR_SERVICE_URL=http://localhost:8010

# For Docker/Production:
# AUTH_SERVICE_URL=http://auth-service:8001
# MODEL_REGISTRY_URL=http://model-registry:8002
# TOKEN_SERVICE_URL=http://token-service:8003
# RECOMMENDATION_URL=http://recommendation-engine:8004
# NEWS_SERVICE_URL=http://news-aggregator:8005
# AI_PROXY_URL=http://ai-proxy-service:8006
# BILLING_SERVICE_URL=http://billing-service:8007
# STORAGE_SERVICE_URL=http://storage-service:8008

# ── AI Provider API Keys ────────────────────────────────────────────────────────
# These are required to proxy AI model requests

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# Google (Gemini)
GOOGLE_API_KEY=your_google_api_key

# Together AI
TOGETHER_API_KEY=your_together_api_key

# Groq
GROQ_API_KEY=gsk_your_groq_api_key

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key

# Mistral
MISTRAL_API_KEY=your_mistral_api_key

# Perplexity
PERPLEXITY_API_KEY=pplx-your_perplexity_api_key

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Replicate
REPLICATE_API_TOKEN=r8_your_replicate_token

# Stability AI
STABILITY_API_KEY=sk-your_stability_api_key

# ── Token Economics ─────────────────────────────────────────────────────────────
# 1 ACT (AICaffe Token) = $0.00005 USD
# Platform margin: 20% on top of provider costs
TOKEN_USD_RATE=0.00005
PLATFORM_MARGIN=0.20

# ── Redis (for caching/sessions - optional) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379
# For Docker:
# REDIS_URL=redis://redis:6379

# ── Email (for notifications - optional) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@aicaffe.com

# ── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR

# ── Security ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://aicaffe.com
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
