# ═══════════════════════════════════════════════════════════════════════════════
# AICaffe Production Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# IMPORTANT: Copy this file to .env and update ALL values before deployment
# Never commit the actual .env file to version control
# ═══════════════════════════════════════════════════════════════════════════════

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED: Update with your production database credentials
DB_HOST=your-postgres-host.com
DB_PORT=5432
DB_USER=aicaffe_prod
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
DB_NAME=aicaffe_production
DB_POOL_MIN=5
DB_POOL_MAX=50

# ── JWT Authentication ────────────────────────────────────────────────────────
# REQUIRED: Generate a secure secret: openssl rand -hex 64
JWT_SECRET=GENERATE_A_64_CHARACTER_RANDOM_SECRET_HERE_USE_OPENSSL_RAND
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── Frontend & API URLs ───────────────────────────────────────────────────────
FRONTEND_URL=https://aicaffe.com
NEXT_PUBLIC_API_URL=https://api.aicaffe.com

# ── CORS & Security ───────────────────────────────────────────────────────────
CORS_ORIGINS=https://aicaffe.com,https://app.aicaffe.com,https://www.aicaffe.com
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Redis Cache ───────────────────────────────────────────────────────────────
REDIS_URL=redis://your-redis-host:6379

# ── Stripe Payment Integration ────────────────────────────────────────────────
# REQUIRED: Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_live_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_live_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_EXPLORER_MONTHLY_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_EXPLORER_YEARLY_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_BUILDER_MONTHLY_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_BUILDER_YEARLY_PRICE_ID=price_xxxxxxxxxxxx

# ── AI Provider API Keys ──────────────────────────────────────────────────────
# Add only the providers you plan to use
OPENAI_API_KEY=sk-your_production_openai_key
ANTHROPIC_API_KEY=sk-ant-your_production_anthropic_key
GOOGLE_API_KEY=your_production_google_key
MISTRAL_API_KEY=your_production_mistral_key
GROQ_API_KEY=gsk_your_production_groq_key
TOGETHER_API_KEY=your_production_together_key
DEEPSEEK_API_KEY=your_production_deepseek_key
PERPLEXITY_API_KEY=pplx-your_production_perplexity_key
REPLICATE_API_TOKEN=r8_your_production_replicate_token
STABILITY_API_KEY=sk-your_production_stability_key
ELEVENLABS_API_KEY=your_production_elevenlabs_key

# ── GitHub OAuth (for Cloud IDE) ──────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ── Token Economics ───────────────────────────────────────────────────────────
TOKEN_USD_RATE=0.00005
PLATFORM_MARGIN=0.20

# ── Email Notifications (Optional) ────────────────────────────────────────────
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=notifications@aicaffe.com
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL=noreply@aicaffe.com

# ── Monitoring & Error Tracking (Optional but Recommended) ────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ── Service Discovery (Docker/Kubernetes) ────────────────────────────────────
# These are automatically set in docker-compose, but can be overridden
AUTH_SERVICE_URL=http://auth-service:8001
MODEL_REGISTRY_URL=http://model-registry:8002
TOKEN_SERVICE_URL=http://token-service:8003
RECOMMENDATION_URL=http://recommendation-engine:8004
NEWS_SERVICE_URL=http://news-aggregator:8005
AI_PROXY_URL=http://ai-proxy-service:8006
BILLING_SERVICE_URL=http://billing-service:8007
STORAGE_SERVICE_URL=http://storage-service:8008
WORKSPACE_SERVICE_URL=http://workspace-service:8009
ORCHESTRATOR_SERVICE_URL=http://orchestrator-service:8010
CLOUD_IDE_SERVICE_URL=http://cloud-ide:8011

# ═══════════════════════════════════════════════════════════════════════════════
# Production Checklist:
# ═══════════════════════════════════════════════════════════════════════════════
# [ ] JWT_SECRET is at least 64 characters and randomly generated
# [ ] DB_PASSWORD is strong and unique
# [ ] All API keys are production keys (not test keys)
# [ ] STRIPE_SECRET_KEY starts with sk_live_ (not sk_test_)
# [ ] CORS_ORIGINS only contains your actual domains
# [ ] SSL/TLS is configured on your load balancer/reverse proxy
# [ ] Database backups are configured
# [ ] Monitoring and alerting is set up
# [ ] Rate limiting is appropriate for your expected traffic
# ═══════════════════════════════════════════════════════════════════════════════
